# older checkouts that still have one at the project root
known_hosts.json

# encrypted saved-profile vault — now written to ~/.cpanel-local/, this only
# matters for older checkouts that still have one at the project root
vault.enc

# logs / OS / editor cruft
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
